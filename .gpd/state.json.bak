{
  "project_reference": {
    "project_md_updated": null,
    "core_research_question": "Does the presence of a future causal horizon in a general FLRW spacetime produce a well-defined decoherence rate, and does it scale logarithmically with T for power-law cosmologies?",
    "current_focus": "Phase 3: Decoherence Integral \u2014 Power-Law FLRW"
  },
  "project_contract": {
    "schema_version": 1,
    "scope": {
      "question": "What is the decoherence rate for a superposed charged body in a general FLRW spacetime with a causal horizon, arising from soft radiation that escapes beyond the horizon?",
      "in_scope": [
        "Conformally invariant fields (electromagnetic and scalar) coupled to a superposed charged body",
        "General FLRW spacetime with a future event horizon",
        "Closed-form decoherence rate expressed in terms of scale factor a(t), Hubble parameter H, and source worldline parameters",
        "Explicit evaluation in pure de Sitter (H = const) as the primary worked example",
        "Connection of the de Sitter result to the Gibbons-Hawking thermal rate T = H/(2pi)"
      ],
      "out_of_scope": [
        "Non-conformally invariant fields (gravity / soft gravitons) \u2014 interesting but much harder",
        "Flat-space DSW formula as a primary anchor (H to 0 limit is IR-divergent and connection is subtle)",
        "Numerical simulations or lattice methods"
      ],
      "unresolved_questions": [
        "Precise definition of which radiation crossed the horizon must be made gauge-invariant and operationally clear",
        "Whether the decoherence exponent admits a fully closed-form expression for general a(t) or only for specific scale factors",
        "How the observer worldline choice (comoving vs static) affects the result"
      ]
    },
    "context_intake": {
